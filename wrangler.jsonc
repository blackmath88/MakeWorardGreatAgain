{
  "name": "wordart-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  // Serves the Vite build (dist/); only /api/* runs the Worker code first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Public app ID. The secret is set via: npx wrangler secret put DISCORD_CLIENT_SECRET
  "vars": { "DISCORD_CLIENT_ID": "1553104669105193090" }
}
